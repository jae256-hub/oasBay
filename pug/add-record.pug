extends layout

block content
  .container.mt-5.mb-5
    .row.justify-content-center
      .col-lg-8
        .card.p-5.shadow-sm
          h2.mb-4.fw-bold Log New Service
          
          .alert.alert-info.mb-4
            strong Pricing Guide: 
            | Engine Oil (UGX 79K-200K), Brake Fluid (UGX 13K-20K), Oil Filter (UGX 15K-20K).
            | Alignment (UGX 30K), Balance (UGX 20K). Standard Labor (UGX 20K).

          form(action="/records", method="POST")
            .row.mb-3
              .col-md-6
                label.form-label Customer Name
                input.form-control(type="text", name="customerName", required)
              .col-md-6
                label.form-label Car Number Plate
                input.form-control(type="text", name="carPlate", required)
            
            .mb-3
              label.form-label Services Performed (Hold Ctrl/Cmd to select multiple)
              select.form-select(name="servicesDone", multiple, required, size="5")
                option(value="Engine Oil and Filters") Engine Oil and Filters
                option(value="Gear Box Oil and Filters") Gear Box Oil and Filters
                option(value="Brake Fluids") Brake Fluids
                option(value="Brake Pads Change") Brake Pads Change
                option(value="Greasing") Greasing
                option(value="Other Minor Repairs") Other Minor Repairs
                option(value="Wheel Alignment") Wheel Alignment
                option(value="Wheel Balance") Wheel Balance
            
            //- DYNAMIC PARTS SECTION
            .mb-4.p-3.border.rounded.bg-light
              label.form-label.fw-bold Parts & Oils Used
              #parts-container
                //- New rows will be injected here by JavaScript
              
              button.btn.btn-outline-primary.btn-sm.mt-2(type="button", onclick="addPartRow()")
                i.bi.bi-plus-circle.me-1
                | Add Part/Oil
            
            .row.mb-4
              .col-md-6
                label.form-label Assigned Technician(s) (Hold Ctrl/Cmd to select multiple)
                select.form-select(name="technicians", multiple, required, size="3")
                  each tech in technicians
                    option(value=tech._id)= tech.name
              .col-md-6
                label.form-label Total Cost (UGX)
                input.form-control(type="number", name="totalCost", required, placeholder="Parts + Fluids + Services + Labor")

            .d-grid
              button.btn.btn-primary.btn-lg(type="submit") Save Record & Deduct Stock

  //- HIDDEN TEMPLATE FOR DYNAMIC ROWS
  template#part-row-template
    .row.mb-2.align-items-center.part-row
      .col-md-7
        select.form-select(name="partNames", required)
          option(value="", disabled, selected) Select Item...
          each items, categoryName in stockByCategory
            optgroup(label=categoryName)
              each item in items
                option(value=item.itemName) #{item.itemName} (In Stock: #{item.quantity})
      .col-md-3
        input.form-control(type="number", name="partQuantities", min="1", value="1", placeholder="Qty", required)
      .col-md-2
        button.btn.btn-danger.btn-sm.w-100(type="button", onclick="this.closest('.part-row').remove()") 
          i.bi.bi-trash

  //- CLIENT-SIDE LOGIC
  script.
    function addPartRow() {
      const container = document.getElementById('parts-container');
      const template = document.getElementById('part-row-template');
      // Clone the template content and append it to the container
      container.appendChild(template.content.cloneNode(true));
    }
    
    // Automatically add one empty row when the page loads
    document.addEventListener('DOMContentLoaded', addPartRow);